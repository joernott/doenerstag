# Copy to `.env` next to docker-compose.traefik.yml.
#
# Only the first two differ from docker-compose.env; the rest is the same file.

# The name the world calls this installation by. It is the Traefik router's
# Host() rule, the name on the Let's Encrypt certificate, and the base of every
# link in a password-reset mail. It must resolve to this host from the public
# internet before the first start, because the ACME challenge is answered on
# port 80 of whatever that name points at.
DOENERSTAG_HOST=doenerstag.example

# Where Let's Encrypt sends expiry warnings. Required: ACME registration has no
# anonymous option.
ACME_EMAIL=admin@example.invalid

# The image tag is here rather than in the compose file so that an upgrade is
# one edit followed by `docker compose pull`.
#
# --behind-tls-proxy arrived in 0.3.0. On an older image the server exits with
# "unknown flag", which is at least a clear failure.
DOENERSTAG_VERSION=0.3.0

# The role that owns the schema, for the update job. The password is never
# stored in the configuration file; leave it unset to be asked.
DOENER_DATABASE_ADMIN_USER=doenerstag_admin

# Which file the import job reads, relative to import/ beside this file.
# DOENERSTAG_IMPORT_FILE=ali_baba.json
# DOENERSTAG_IMPORT_ARGS=--overwrite

# No DOENERSTAG_PORT: nothing is published but Traefik's 80 and 443.
