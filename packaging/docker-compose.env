# Copy to `.env` next to docker-compose.yml.
#
# The image tag is here rather than in the compose file so that an upgrade is
# one edit followed by `docker compose pull`.
DOENERSTAG_VERSION=0.2.0

# The published port. The container always listens on 8443.
DOENERSTAG_PORT=8443

# The role that owns the schema, for the update job. The password is never
# stored in the configuration file; leave it unset to be asked.
DOENER_DATABASE_ADMIN_USER=doenerstag_admin

# Which file the import job reads, relative to import/ beside this file, and
# anything else to pass it. --overwrite replaces a restaurant that is already
# there, destroying its orders.
# DOENERSTAG_IMPORT_FILE=ali_baba.json
# DOENERSTAG_IMPORT_ARGS=--overwrite
