{
  "name": "doenerstag-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build for the doenerstag web frontend. Output goes to ../static.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "i18n": "node scripts/i18n.mjs",
    "typecheck": "node scripts/i18n.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "swagger-ui-dist": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
