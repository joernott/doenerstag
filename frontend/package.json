{
  "name": "doenerstag-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Build for the doenerstag web frontend. Output goes to ../static.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "i18n": "node scripts/i18n.mjs",
    "typecheck": "node scripts/i18n.mjs && tsc --noEmit",
    "lint": "node scripts/i18n.mjs && eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "swagger-ui-dist": "^5.35.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild": false,
    "@parcel/watcher": false,
    "@scarf/scarf": false
  }
}
