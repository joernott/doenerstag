# Build output
/doenerstag
/doenerstag.exe
/dist/
*.exe
*.test

# Test and coverage artefacts
coverage.out
coverage.html
*-coverage.out
*-coverage.html
*.prof

# Frontend toolchain
/frontend/node_modules/
/frontend/.cache/

# Playwright output: reports, traces and screenshots from a failed run.
/frontend/playwright-report/
/frontend/test-results/

# Generated from the catalogs beside it by scripts/i18n.mjs, on every build and
# before every test run. Committing it would make it possible for the language
# list to disagree with the catalogs actually present.
/frontend/src/i18n/registry.generated.ts

# Local configuration and secrets.
# doenerstag.yaml holds the database password and the JWT secret; never commit it.
/doenerstag.yaml
/doenerstag.local.yaml
*.crt
*.key
*.pem
/secrets/

# Local log output
*.log

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# NOTE: /static is generated by the frontend build but IS committed, so that a
# release can be built without the Node toolchain. See docs/08_technologies.md.
